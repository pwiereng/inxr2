# INXR2 Environment Configuration Template
# Copy this file to .env and customize for your environment
# NEVER commit .env to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database Name
POSTGRES_DB=inxr2_dev

# PostgreSQL User
POSTGRES_USER=inxr2_user

# PostgreSQL Password
# SECURITY: Use a strong password in production!
POSTGRES_PASSWORD=changeme_dev_password

# PostgreSQL Host (embedded inside dev container)
POSTGRES_HOST=localhost

# PostgreSQL Port
POSTGRES_PORT=5432

# Database URL (constructed from above variables)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://inxr2_user:changeme_dev_password@localhost:5432/inxr2_dev

# Test Database URL
TEST_DATABASE_URL=postgresql://inxr2_user:changeme_dev_password@localhost:5432/inxr2_test

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Debug Mode (true/false)
# WARNING: Set to false in production!
DEBUG=true

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Application Port (exposed to host)
APP_PORT=8000

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Force polling for file watching (needed for Docker on some systems)
WATCHFILES_FORCE_POLLING=true

# =============================================================================
# SECURITY (Production Only)
# =============================================================================

# Secret key for session management, JWT, etc.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=your_secret_key_here

# Allowed hosts (comma-separated, no spaces)
# ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# CORS Origins (comma-separated, no spaces)
# CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# =============================================================================
# REPOSITORY CONFIGURATION
# =============================================================================

# Directory containing git repositories to index
# This path is mounted into the container at /repos
# Set to the directory containing your git repositories
# INXR2_REPOS_DIR=/path/to/your/repos

# Path to your inxr2 config file (optional)
# INXR2_CONFIG=/path/to/your/config.yaml

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Database Connection Pool Size
# DB_POOL_SIZE=10

# Database Max Overflow Connections
# DB_MAX_OVERFLOW=20

# API Rate Limiting (requests per minute)
# API_RATE_LIMIT=60

# Maximum file size for indexing (in KB)
# MAX_FILE_SIZE_KB=1024

# =============================================================================
# NOTES
# =============================================================================
# 1. Copy this file to .env for development
# 2. Copy this file to .env.prod for production and update all values
# 3. Never commit .env files to version control
# 4. Use strong passwords in production
# 5. Keep SECRET_KEY secret and unique per environment
