# INXR2 Production Environment Configuration Template
# Copy this file to .env.prod and customize for production
# NEVER commit .env.prod to version control!
#
# NOTE: INXR2 is a local dev tool — "production" means running locally with
# stricter settings. PostgreSQL is embedded inside the container (localhost).

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

POSTGRES_DB=inxr2
POSTGRES_USER=inxr2_user
# SECURITY: Use a strong password! Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGEME_STRONG_PRODUCTION_PASSWORD
# PostgreSQL is embedded in the container — always localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://inxr2_user:CHANGEME_STRONG_PRODUCTION_PASSWORD@localhost:5432/inxr2

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
APP_PORT=8000

# =============================================================================
# SECURITY
# =============================================================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGEME_GENERATE_RANDOM_SECRET_KEY

# Allowed hosts (comma-separated, no spaces)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# CORS Origins (comma-separated, no spaces)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# PERFORMANCE
# =============================================================================

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
API_RATE_LIMIT=100

# =============================================================================
# OPTIONAL
# =============================================================================

MAX_FILE_SIZE_KB=1024
