# Development Dockerfile for INXR2
# This image includes Python, Node.js, PostgreSQL server, and all development tools

# Node.js toolchain source, pinned by digest.
#
# Node is copied out of the official image rather than installed from the
# NodeSource apt repo: that repo is a third-party host with no pinning story,
# and when it started returning 403 for its GPG key and package indices the
# dev image could not be built at all (issue #538). The official image is on
# Docker Hub, which this build already depends on for the Python base, so this
# adds no new trust domain — and the digest makes the Node/npm versions
# reproducible instead of "whatever node_20.x resolves to today".
#
# Must stay on the same Debian release as the base image below (trixie), since
# the copied `node` binary links against the base image's glibc/libstdc++.
#
# To update: pick a tag, resolve its multi-arch index digest, and paste it here:
#   docker buildx imagetools inspect node:20-trixie-slim | head -3
FROM node:20-trixie-slim@sha256:abfbe12cc943141a0c9e8c0a57d710df1dadd95d35e8662cc02958b284d1f35b AS node

FROM python:3.11-slim

# Prevent Python from writing pyc files and buffering stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Build essentials
    build-essential \
    gcc \
    g++ \
    make \
    # Git
    git \
    # PostgreSQL server + client (embedded, runs as devuser)
    postgresql \
    postgresql-client \
    # Process utilities (pkill, pgrep, ps, top)
    procps \
    # HTTP client (used ad hoc for API pokes and downloads during development)
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Node.js + npm, copied from the digest-pinned official image above.
#
# Only the Node-owned paths are copied, NOT all of /usr/local — the Python base
# image keeps its interpreter and stdlib under /usr/local, so copying the whole
# tree would clobber Python. node_modules carries npm and corepack; the bin
# symlinks into it are recreated here because `npm`/`npx`/`corepack` in the
# source image are relative symlinks that COPY does not resolve. corepack is
# kept because the NodeSource package this replaces also shipped it.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack

# Verify installations. The node check also asserts the major version still
# satisfies frontend/package.json "engines", so a bad digest bump fails the
# build here rather than at `npm ci` time.
RUN python --version && \
    node --version && \
    node -e 'if (+process.versions.node.split(".")[0] < 20) { throw new Error("node >= 20 required"); }' && \
    npm --version && \
    git --version

# Set working directory
WORKDIR /workspace

# Install Python packages into system Python at build time from a fully
# resolved, hash-pinned lockfile so container builds are reproducible.
# Docker provides isolation, so no venv is needed.
#
# requirements.lock is generated from BOTH pyproject.toml files (the dev
# container shares one Python env between inxr2 and the MCP server, so they
# are locked together) plus requirements-build.in (the build backends —
# setuptools/wheel for inxr2, hatchling/editables for the MCP server — so the
# build toolchain is pinned too) via:
#   uv pip compile pyproject.toml mcp-server/pyproject.toml \
#       requirements-build.in --extra dev --generate-hashes -o requirements.lock
# Regenerate it whenever a dependency in either pyproject.toml changes.
#
# A minimal package structure is created for the editable installs; the real
# source is bind-mounted at runtime and picked up via the .pth file in
# site-packages. The editable installs use:
#   --no-deps             install only the local package; never re-resolve
#                         (and drift from) the locked dependency set
#   --no-build-isolation  build against the build backends already installed
#                         from the lock above, instead of fetching unpinned,
#                         unhashed build backends fresh from PyPI per build
COPY pyproject.toml README.md requirements.lock ./
COPY mcp-server/pyproject.toml /tmp/mcp-server/pyproject.toml
COPY mcp-server/src/ /tmp/mcp-server/src/
RUN pip install --no-cache-dir --upgrade 'pip>=26.0' && \
    pip install --no-cache-dir --require-hashes -r requirements.lock && \
    mkdir -p src/inxr2 && touch src/inxr2/__init__.py && \
    pip install --no-cache-dir --no-deps --no-build-isolation -e . && \
    pip install --no-cache-dir --no-deps --no-build-isolation -e /tmp/mcp-server && \
    rm -rf src /tmp/mcp-server

# Create non-root user for development
ARG USERNAME=devuser
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && apt-get update \
    && apt-get install -y sudo \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Switch to non-root user
USER $USERNAME

# Create PostgreSQL data directory owned by devuser
RUN mkdir -p /home/devuser/pgdata && chown devuser:devuser /home/devuser/pgdata

# Copy and set up entrypoint script
COPY --chown=devuser:devuser scripts/docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Expose ports
# 8000 - FastAPI backend
# 5173 - Vite frontend dev server
# 3000 - MCP server (SSE transport)
# 5432 - PostgreSQL (embedded, internal only)
EXPOSE 8000 5173 3000

# Set entrypoint to handle dependency installation
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Default command (can be overridden by docker-compose)
CMD ["/bin/bash"]
