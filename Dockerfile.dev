# Development Dockerfile for INXR2
# This image includes Python, Node.js, PostgreSQL client, and all development tools

FROM python:3.11-slim

# Prevent Python from writing pyc files and buffering stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Build essentials
    build-essential \
    gcc \
    g++ \
    make \
    # Git
    git \
    # PostgreSQL client
    postgresql-client \
    # Node.js (install from NodeSource)
    curl \
    ca-certificates \
    gnupg \
    && update-ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    # Tree-sitter build dependencies
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Verify installations
RUN python --version && \
    node --version && \
    npm --version && \
    git --version

# Create non-root user for development
ARG USERNAME=devuser
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && apt-get update \
    && apt-get install -y sudo \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Install uv (modern, fast Python package installer) with checksum verification
# Version pinned to 0.9.21 for supply-chain security
ENV UV_VERSION=0.9.21
ENV UV_CHECKSUM=0a1ab27383c28ef1c041f85cbbc609d8e3752dfb4b238d2ad97b208a52232baf
RUN curl -LsSf https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz -o /tmp/uv.tar.gz && \
    echo "${UV_CHECKSUM}  /tmp/uv.tar.gz" | sha256sum -c - && \
    mkdir -p /usr/local/cargo/bin && \
    tar -xzf /tmp/uv.tar.gz -C /usr/local/cargo/bin && \
    rm /tmp/uv.tar.gz

# Switch to non-root user
USER $USERNAME

# Ensure cache directories exist with proper permissions and copy uv to user's bin
RUN mkdir -p /home/devuser/.cache /home/devuser/.cargo/bin && \
    cp /usr/local/cargo/bin/uv* /home/devuser/.cargo/bin/

# Create virtual environment in home directory
RUN python -m venv /home/devuser/.venv

# Add venv and uv to PATH, and set VIRTUAL_ENV
ENV VIRTUAL_ENV="/home/devuser/.venv" \
    PATH="/home/devuser/.venv/bin:/home/devuser/.cargo/bin:/home/devuser/.local/bin:${PATH}"

# Copy and set up entrypoint script
COPY --chown=devuser:devuser scripts/docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Expose ports
# 8000 - FastAPI backend
# 5173 - Vite frontend dev server
# 5432 - PostgreSQL (will be in separate container)
EXPOSE 8000 5173

# Set entrypoint to handle dependency installation
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Default command (can be overridden by docker-compose)
CMD ["/bin/bash"]
