# Development Dockerfile for INXR2
# This image includes Python, Node.js, PostgreSQL server, and all development tools

FROM python:3.11-slim

# Prevent Python from writing pyc files and buffering stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Build essentials
    build-essential \
    gcc \
    g++ \
    make \
    # Git
    git \
    # PostgreSQL server + client (embedded, runs as devuser)
    postgresql \
    postgresql-client \
    # Process utilities (pkill, pgrep, ps, top)
    procps \
    # Node.js (install from NodeSource via signed apt repo)
    curl \
    gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" \
       > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y nodejs \
    # Tree-sitter build dependencies
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Verify installations
RUN python --version && \
    node --version && \
    npm --version && \
    git --version

# Set working directory
WORKDIR /workspace

# Install Python packages into system Python at build time from a fully
# resolved, hash-pinned lockfile so container builds are reproducible.
# Docker provides isolation, so no venv is needed.
#
# requirements.lock is generated from BOTH pyproject.toml files (the dev
# container shares one Python env between inxr2 and the MCP server, so they
# are locked together) via:
#   uv pip compile pyproject.toml mcp-server/pyproject.toml \
#       --extra dev --generate-hashes -o requirements.lock
# Regenerate it whenever a dependency in either pyproject.toml changes.
#
# A minimal package structure is created for the editable installs; the real
# source is bind-mounted at runtime and picked up via the .pth file in
# site-packages. Editable installs use --no-deps so they install only the
# local package and never re-resolve (and drift from) the locked dep set.
COPY pyproject.toml README.md requirements.lock ./
COPY mcp-server/pyproject.toml /tmp/mcp-server/pyproject.toml
COPY mcp-server/src/ /tmp/mcp-server/src/
RUN pip install --no-cache-dir --upgrade 'pip>=26.0' 'wheel>=0.46.2' && \
    pip install --no-cache-dir --require-hashes -r requirements.lock && \
    mkdir -p src/inxr2 && touch src/inxr2/__init__.py && \
    pip install --no-cache-dir --no-deps -e . && \
    pip install --no-cache-dir --no-deps -e /tmp/mcp-server && \
    rm -rf src /tmp/mcp-server

# Create non-root user for development
ARG USERNAME=devuser
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && apt-get update \
    && apt-get install -y sudo \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Switch to non-root user
USER $USERNAME

# Create PostgreSQL data directory owned by devuser
RUN mkdir -p /home/devuser/pgdata && chown devuser:devuser /home/devuser/pgdata

# Copy and set up entrypoint script
COPY --chown=devuser:devuser scripts/docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Expose ports
# 8000 - FastAPI backend
# 5173 - Vite frontend dev server
# 3000 - MCP server (SSE transport)
# 5432 - PostgreSQL (embedded, internal only)
EXPOSE 8000 5173 3000

# Set entrypoint to handle dependency installation
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Default command (can be overridden by docker-compose)
CMD ["/bin/bash"]
