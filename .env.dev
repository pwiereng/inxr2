# INXR2 Development Environment Configuration
# This file contains development defaults
# For production, create .env.prod with secure values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

POSTGRES_DB=inxr2_dev
POSTGRES_USER=inxr2_user
POSTGRES_PASSWORD=inxr2_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://inxr2_user:inxr2_dev_password@postgres:5432/inxr2_dev
PGDATA=/var/lib/postgresql/data/pgdata

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
APP_PORT=8000

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

WATCHFILES_FORCE_POLLING=true
